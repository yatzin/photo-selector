# Copy to .env for local development (`npm run dev`).

NEXT_TELEMETRY_DISABLED=1

# Container: file:/data/photo-selector.db  |  Local: file:./prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Leave unset locally: the host and port are taken from each request.
# AUTH_URL="http://localhost:3200"

# Photo folders. The container uses /photos/upload and /photos/dropoff (mapped
# in docker-compose.yml). Locally, point at test folders or the share itself:
#   PHOTOS_UPLOAD_DIR="\ugreen\Photo\Mobile Upload"
PHOTOS_UPLOAD_DIR="./dev-photos/upload"
PHOTOS_DROPOFF_DIR="./dev-photos/dropoff"

# Initial admin account (created on first seed only). Without ADMIN_PASSWORD
# the seed uses admin@localhost / changeme and forces a reset on first login.
# ADMIN_NAME="Your Name"
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="your-secure-password"

# Thumbnail/preview cache. Container: /data/cache  |  Local: ./.data/cache
PHOTOS_CACHE_DIR="./.data/cache"
